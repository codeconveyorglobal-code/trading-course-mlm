PORT=5000
MONGODB_URI=mongodb://localhost:27017/trading-mlm
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=30d
ADMIN_JWT_SECRET=admin_super_secret_key_change_in_production

# NOWPayments Crypto Payment
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_ipn_secret
NOWPAYMENTS_CALLBACK_URL=http://localhost:5000/api/payments/callback

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=50000000

# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=noreply@tradingcourse.com

# Frontend URLs
ADMIN_URL=http://localhost:3000
APP_URL=http://localhost:3001
CLIENT_URL=http://localhost:3000

# MLM Default Settings
DEFAULT_DIRECT_COMMISSION=10
DEFAULT_BINARY_COMMISSION=5
DEFAULT_LEVEL_COMMISSION=2
